# Copy to .env or .env.local and adjust for your machine.
# Resolution order: .env -> .env.{APP_ENV} -> .env.local -> .env.{APP_ENV}.local

# Runtime
APP_ENV=local
NODE_ENV=development

# HTTP server
HTTP_PORT=9000
HTTPS_PORT=8090
SESSION_SECRET=change-me
SESSION_EXPIRY=300
IS_HTTPS=false
IS_SESSION_REQUIRED=false

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=urbanoak
MYSQL_USER=root
MYSQL_PASSWORD=root

# MongoDB
MONGO_ENABLED=true
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=urbanoak
MONGO_USER=root
MONGO_PASSWORD=root
MONGO_AUTH_SOURCE=admin
MONGO_AUTH_MECHANISM=SCRAM-SHA-1

# Redis / cache
REDIS_URL=redis://127.0.0.1:6379
CACHE_ENABLED=true

# S3 (credentials via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE)
S3_REGION=ap-south-1
S3_BUCKET_NAME=urbanoak
S3_CATALOG_PREFIX=catalog
S3_PUBLIC_BASE_URL=
S3_MAX_IMAGE_SIZE_BYTES=10485760

# Elasticsearch
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_NAME=urbanoak_products
ELASTICSEARCH_WORKER_POLL_MS=2000
ELASTICSEARCH_WORKER_BATCH_SIZE=10

# Kafka (comma-separated brokers)
KAFKA_ENABLED=true
KAFKA_CLIENT_ID=urbanoak-api
KAFKA_BROKERS=127.0.0.1:9092

# Email (optional for local dev — falls back to console transport)
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=UrbanOak <no-reply@urbanoak.com>
EMAIL_REPLY_TO=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_POOL=true
SMTP_USER=
SMTP_PASS=

# Password reset links (frontend URL)
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_MIN_PASSWORD_LENGTH=8

# Admin
ADMIN_MIN_PASSWORD_LENGTH=8
