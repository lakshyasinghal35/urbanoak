		"password":"root"
	},
	"mongoDB":{
		"host":"127.0.0.1",
		"port":27017,
		"database_name":"urbanoak",
		"user":"root",
		"password":"root",
		"auth_mechanism":"SCRAM-SHA-1",
		"auth_source":"admin"
	},
	"s3":{
		"region":"ap-south-1",
		"bucket_name":"urbanoak",
		"catalog_prefix":"catalog",
		"public_base_url":""
	},
