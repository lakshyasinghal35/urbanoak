                "admins"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 2,\n  \"name\": \"Updated Admin\",\n  \"role\": \"admin\",\n  \"is_active\": true\n}",
              "options": {
